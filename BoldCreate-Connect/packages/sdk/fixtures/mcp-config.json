    "expected": "{\n  \"mcpServers\": {\n    \"a b\": {\n      \"type\": \"http\",\n      \"url\": \"https://z/last\",\n      \"headers\": {\n        \"authorization\": \"Bearer ${CONNECT_TOKEN}\"\n      }\n    },\n    \"second\": {\n      \"type\": \"http\",\n      \"url\": \"https://y\",\n      \"headers\": {}\n    }\n  }\n}\n"
