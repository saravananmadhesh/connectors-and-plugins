        "headers": {},
        "ready": true,
        "setup": {
          "kind": "none"
        }
      },
      {
        "name": "a b",
        "url": "https://z/last",
        "headers": {
          "authorization": "Bearer stk_def"
        },
        "ready": false,
        "setup": {
          "kind": "variables",
          "names": ["T"]
