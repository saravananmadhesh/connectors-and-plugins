# ─────────────────────────────────────────────────────────────────────────────
# Template for `pnpm dev:staging`: all apps run on this machine against staging services.
#
#   1. Copy to .env.staging.local (gitignored; never commit it or paste it anywhere).
#   2. Replace every REPLACE_* value. The launcher refuses to start while any remain.
#   3. gcloud auth application-default login   (Cloud KMS and Secret Manager)
#   4. pnpm dev:staging --yes
#
# [common] applies to every app; each app section adds its own keys on top. An app never sees
# another app's section. DEPLOY_ENV is always staging; NODE_ENV defaults to production.
# Fetch secret values from Secret Manager rather than typing them:
#   gcloud secrets versions access latest --secret=<name> --project=<project>
# ─────────────────────────────────────────────────────────────────────────────

[common]
LOG_LEVEL=info
# Local addresses of the apps. APP_BASE_URL and OAUTH_REDIRECT_URI must be registered on the
# staging OAuth client, or sign-in fails.
APP_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3001
PUBLIC_GATEWAY_URL=http://localhost:3002
OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/callback

[api]
PORT=3001
# With SSL. Through the Cloud SQL Auth Proxy use 127.0.0.1 and the proxy's port.
DATABASE_URL=REPLACE_postgresql://app_api:PASSWORD@HOST:5432/DB?sslmode=require
WORKLOAD_SECRET=REPLACE_WITH_STAGING_VALUE
REDIS_URL=REPLACE_rediss://:PASSWORD@HOST:6380
KMS_ADAPTER=cloud-kms
KMS_CLOUD_KEY_NAME=REPLACE_projects/P/locations/L/keyRings/R/cryptoKeys/K
BLOB_BUCKET=REPLACE_WITH_BUCKET
BLOB_REGION=REPLACE_WITH_REGION
BFF_CALLER_ALLOWLIST=web,admin,gateway
# S3 access: IAM user key pair (needs s3:GetObject, PutObject, DeleteObject, ListBucket on the
# bucket). Skip both lines if you use `aws sso login` with AWS_PROFILE. Not BLOB_ACCESS_KEY_ID.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_PROFILE=...

[gateway]
PORT=3002
DATABASE_URL=REPLACE_postgresql://app_gateway:PASSWORD@HOST:5432/DB?sslmode=require
API_BASE_URL=http://localhost:3001
WORKLOAD_SECRET=REPLACE_WITH_STAGING_VALUE
REDIS_URL=REPLACE_rediss://:PASSWORD@HOST:6380
KMS_ADAPTER=cloud-kms
KMS_CLOUD_KEY_NAME=REPLACE_projects/P/locations/L/keyRings/R/cryptoKeys/K

[admin]
PORT=3004
DATABASE_URL=REPLACE_postgresql://app_admin:PASSWORD@HOST:5432/DB?sslmode=require
API_BASE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3004
WORKLOAD_SECRET=REPLACE_WITH_STAGING_VALUE
COOKIE_SECRET=REPLACE_WITH_STAGING_VALUE
CSRF_SECRET=REPLACE_WITH_STAGING_VALUE
ADMIN_ALLOWED_EMAILS=REPLACE_you@yourdomain.com

[web]
PORT=3000
API_BASE_URL=http://localhost:3001
WORKLOAD_SECRET=REPLACE_WITH_STAGING_VALUE
COOKIE_SECRET=REPLACE_WITH_STAGING_VALUE
CSRF_SECRET=REPLACE_WITH_STAGING_VALUE

[worker]
HEALTH_PORT=3005
DATABASE_URL=REPLACE_postgresql://app_worker:PASSWORD@HOST:5432/DB?sslmode=require
REDIS_URL=REPLACE_rediss://:PASSWORD@HOST:6380
KMS_ADAPTER=cloud-kms
KMS_CLOUD_KEY_NAME=REPLACE_projects/P/locations/L/keyRings/R/cryptoKeys/K
SECRETS_ADAPTER=gcp-secret-manager
GCP_PROJECT_ID=REPLACE_WITH_PROJECT_ID
EMAIL_ADAPTER=ses
SES_REGION=us-east-1
# SES is in a different AWS account than the bucket: its own key pair (ses:SendEmail,
# ses:SendRawEmail). Set both or neither; neither means the default AWS credential chain.
# SES_ACCESS_KEY_ID=AKIA...
# SES_SECRET_ACCESS_KEY=...
EMAIL_FROM=noreply@sfcodestudio.com
BLOB_BUCKET=REPLACE_WITH_BUCKET
BLOB_REGION=REPLACE_WITH_REGION
OUTBOX_POLL_INTERVAL_MS=5000
# S3 access: IAM user key pair for the bucket above (the AWS account of the bucket, not the
# email provider). Skip these lines if you use `aws sso login` with AWS_PROFILE.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_PROFILE=...
