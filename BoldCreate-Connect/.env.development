# ─────────────────────────────────────────────────────────────────────────────
# Development / local-test environment — committed, non-secret values only.
# Loaded automatically by scripts/dev.ts and the test runner (scripts/test-runner/).
#
# Secrets (signing keys, database passwords, ...) are never stored here: they are
# generated on first start into .cache/dev/secrets.json (see scripts/dev-secrets.ts).
# For deployed environments, secrets come from the platform's secret manager.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL started by pnpm dev (data in .cache/dev/postgres); the login is added at start
DATABASE_URL=postgresql://localhost:5432/boldcreate

# Where PostgreSQL runs (also: pnpm dev --postgres=<mode>, pnpm dev:docker, pnpm test -- --postgres=<mode>)
#   embedded  the embedded server, no Docker (default)
#   docker    a container started and stopped by pnpm dev; image and name below
#   external  a server you run; set DATABASE_URL in your shell with a login that can create databases,
#             for example postgresql://postgres:secret@localhost:5432/boldcreate
POSTGRES_MODE=embedded
# POSTGRES_DOCKER_IMAGE=postgres:17
# POSTGRES_DOCKER_CONTAINER=boldcreate-dev-postgres

# ── Ports (all optional; the value shown is the default) ───────────────────────
# Service URLs (CONNECTOR_BASE_URL, API_BASE_URL, APP_BASE_URL, MAILPIT_SMTP_URL) follow
# these ports unless set explicitly.
# PORT_WEB=3000
# PORT_API=3001
# PORT_GATEWAY=3002
# PORT_CONNECTOR=3003
# PORT_ADMIN=3004
# PORT_DASHBOARD=5080
# PORT_MAILPIT_HTTP=8025
# PORT_MAILPIT_SMTP=1025
# PORT_POSTGRES=5432

# ── Worker ────────────────────────────────────────────────────────────────────
# mailpit = local SMTP dev server (started by pnpm dev)
DEPLOY_ENV=local
EMAIL_ADAPTER=mailpit
EMAIL_FROM=noreply@localhost
OUTBOX_POLL_INTERVAL_MS=1000

# ── Sessions (development only) ───────────────────────────────────────────────
# Longer than the product defaults (customer 30 min idle / 12 h, admin 15 min idle / 1 h) so a
# developer is not signed out while working. Deployed environments keep the defaults.
SESSION_IDLE_SECONDS=28800
SESSION_ABSOLUTE_SECONDS=2592000
