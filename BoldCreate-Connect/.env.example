# ─────────────────────────────────────────────────────────────────────────────
# Environment variable reference for deployed environments: set these as managed
# secrets in your deployment environment. Local development needs no copy of this
# file: secrets are generated into .cache/dev/secrets.json by pnpm dev.
#
# PRODUCTION RULES:
#   - Never commit real secrets to source control.
#   - All SECRET_* values must come from a secrets manager (e.g. GCP Secret Manager).
#   - The local KMS adapter is refused in staging and production; a managed key service is required.
#   - DATABASE_URL must use the production connection string with SSL.
#   - WORKLOAD_SECRET, CSRF_SECRET, COOKIE_SECRET must be randomly generated (32+ bytes).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# Production: use Cloud SQL Auth Proxy or private VPC connection with SSL.
DATABASE_URL=REPLACE_WITH_PRODUCTION_DATABASE_URL

# ── Ports ─────────────────────────────────────────────────────────────────────
PORT_API=3001
PORT_GATEWAY=3002
PORT_CONNECTOR=3003
PORT_ADMIN=3004
PORT_WEB=3000

# ── Shared secrets ────────────────────────────────────────────────────────────
# Production: generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKLOAD_SECRET=REPLACE_WITH_RANDOM_SECRET
CSRF_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET
COOKIE_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# ── API ───────────────────────────────────────────────────────────────────────
CONNECTOR_BASE_URL=http://localhost:3003

# ── Connector ─────────────────────────────────────────────────────────────────
# Caller ids allowed to invoke the connector (comma separated)
API_CALLER_ALLOWLIST=api,worker

# ── Web BFF ───────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3001

# ── Adapters (worker, gateway, connector as listed) ───────────────────────────
# Key management (worker, api, gateway): cloud-kms when deployed; local is development only
KMS_ADAPTER=cloud-kms
# Required when KMS_ADAPTER=cloud-kms
KMS_CLOUD_KEY_NAME=projects/REPLACE/locations/REPLACE/keyRings/REPLACE/cryptoKeys/REPLACE
# Secrets (worker): local (local only) | gcp-secret-manager
SECRETS_ADAPTER=gcp-secret-manager
# Required when SECRETS_ADAPTER=gcp-secret-manager
GCP_PROJECT_ID=REPLACE_WITH_PROJECT_ID
# Redis must use TLS when deployed; credentials and the server CA are optional
REDIS_URL=rediss://REPLACE_WITH_HOST:6380
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS_CA=/etc/redis/ca.pem
# Object storage uses the cloud default credential chain when deployed (web identity federation
# when AWS_WEB_IDENTITY_TOKEN_FILE and AWS_ROLE_ARN are set); static BLOB_ACCESS_KEY_ID and
# BLOB_SECRET_ACCESS_KEY are refused.
# BLOB_BUCKET=
# BLOB_REGION=

# ── Worker ────────────────────────────────────────────────────────────────────
# mailpit (local and test only) | ses
EMAIL_ADAPTER=ses
# Required when EMAIL_ADAPTER=ses (credentials come from the default chain)
SES_REGION=REPLACE_WITH_REGION
# SES_CONFIGURATION_SET=
# Required when EMAIL_ADAPTER=mailpit
# MAILPIT_SMTP_URL=smtp://localhost:1025
EMAIL_FROM=noreply@yourdomain.com
OUTBOX_POLL_INTERVAL_MS=5000

# ── App base URL (used in email links) ────────────────────────────────────────
APP_BASE_URL=https://yourdomain.com
