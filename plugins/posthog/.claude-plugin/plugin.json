{
  "name": "posthog",
  "displayName": "PostHog",
  "version": "0.1.0",
  "description": "Query product analytics, manage feature flags, and investigate errors in PostHog.",
  "author": {
    "name": "BoldCreate Connect"
  },
  "homepage": "https://posthog.com/docs/model-context-protocol",
  "repository": "https://github.com/saravananmadhesh/BoldCreate-Plugins",
  "keywords": [
    "posthog",
    "analytics",
    "feature-flags",
    "errors",
    "mcp"
  ],
  "userConfig": {
    "POSTHOG_API_KEY": {
      "type": "string",
      "title": "PostHog personal API key",
      "description": "Create one in PostHog under Settings > Personal API keys, using the MCP Server preset.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.POSTHOG_API_KEY}"
      }
    }
  }
}
