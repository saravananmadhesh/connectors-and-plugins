{
  "name": "firebase-sql-connect",
  "displayName": "Firebase SQL Connect",
  "version": "0.1.0",
  "minClientVersions": {
    "cursor": "3.19.0"
  },
  "description": "Work with Firebase SQL Connect (Data Connect) services, schemas, and queries.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://firebase.google.com/docs/reference/sql-connect/mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "firebase",
    "data connect",
    "sql connect",
    "postgres",
    "graphql",
    "mcp"
  ],
  "category": "database",
  "tags": [
    "database",
    "google",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "CLIENT_ID": {
        "type": "string",
        "title": "Client ID",
        "description": "A Google OAuth client your team created. Every team member signs in under it.",
        "x-sensitive": false
      },
      "CLIENT_SECRET": {
        "type": "string",
        "title": "Client secret",
        "description": "The secret for that OAuth client. Stored encrypted.",
        "writeOnly": true,
        "format": "password",
        "x-sensitive": true
      }
    },
    "required": [
      "CLIENT_ID",
      "CLIENT_SECRET"
    ]
  },
  "mcpServers": "./mcp.json"
}
