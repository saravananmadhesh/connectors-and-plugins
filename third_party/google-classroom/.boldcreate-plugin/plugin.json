{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "google-classroom",
  "displayName": "Google Classroom",
  "version": "0.1.0",
  "description": "Read courses, rosters, and coursework, and post announcements in Google Classroom.",
  "author": {
    "name": "BoldCreate Connect"
  },
  "homepage": "https://developers.google.com/workspace/guides/configure-mcp-servers",
  "repository": "https://github.com/saravananmadhesh/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "productivity",
  "keywords": [
    "google classroom",
    "education",
    "courses",
    "google workspace",
    "mcp"
  ],
  "hostedBy": "vendor",
  "stage": "preview",
  "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers",
  "rollout": {
    "phase": 2,
    "wave": "B"
  },
  "supportedByGateway": true,
  "variables": {
    "CLIENT_ID": {
      "title": "Client ID",
      "description": "A Google OAuth client your team created. Every team member signs in under it.",
      "required": true,
      "secret": false
    },
    "CLIENT_SECRET": {
      "title": "Client secret",
      "description": "The secret for that OAuth client. Stored encrypted.",
      "required": true,
      "secret": true
    }
  },
  "components": {
    "mcp": [
      {
        "name": "google-classroom",
        "transport": "streamable-http",
        "url": "https://classroommcp.googleapis.com/mcp/v1",
        "auth": {
          "type": "oauth",
          "alternatives": [],
          "oauthClient": {
            "clientId": "${CLIENT_ID}",
            "clientSecret": "${CLIENT_SECRET}"
          },
          "scopes": [
            "https://www.googleapis.com/auth/classroom.announcements",
            "https://www.googleapis.com/auth/classroom.courses.readonly",
            "https://www.googleapis.com/auth/classroom.coursework.students",
            "https://www.googleapis.com/auth/classroom.courseworkmaterials",
            "https://www.googleapis.com/auth/classroom.rosters.readonly",
            "https://www.googleapis.com/auth/classroom.student-submissions.students.readonly",
            "https://www.googleapis.com/auth/classroom.topics.readonly"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "vendor docs (developers.google.com/workspace/guides/configure-mcp-servers)"
  }
}
