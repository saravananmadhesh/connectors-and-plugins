{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "atlassian",
  "displayName": "Atlassian (Jira + Confluence)",
  "version": "0.7.1",
  "description": "Connect to Atlassian products including Jira and Confluence. Search and create issues, access documentation, manage sprints, and integrate your development workflow with Atlassian's collaboration tools.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://github.com/atlassian/atlassian-mcp-server",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "project-management",
  "keywords": [
    "jira",
    "confluence",
    "atlassian",
    "issues",
    "wiki",
    "mcp"
  ],
  "hostedBy": "vendor",
  "docs": "https://github.com/atlassian/atlassian-mcp-server",
  "upstream": {
    "repository": "https://github.com/atlassian/atlassian-mcp-server",
    "path": "skills",
    "commit": "3be55622453304b905f0c0fd5ef96fa4d638627c",
    "author": "Atlassian",
    "license": "Apache-2.0"
  },
  "rollout": {
    "phase": 1,
    "wave": "B"
  },
  "supportedByGateway": true,
  "variables": {},
  "components": {
    "mcp": [
      {
        "name": "atlassian",
        "transport": "streamable-http",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "auth": {
          "type": "oauth",
          "alternatives": [
            "basic-api-token"
          ]
        }
      }
    ],
    "skills": [
      "atlassian-mcp-code-search",
      "capture-tasks-from-meeting-notes",
      "generate-status-report",
      "jira-sprint-dashboard",
      "search-company-knowledge",
      "spec-to-backlog",
      "triage-issue"
    ],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": "2026-11-10",
    "source": "vendor docs"
  }
}
