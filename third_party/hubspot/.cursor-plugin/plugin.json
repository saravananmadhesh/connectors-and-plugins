{
  "name": "hubspot",
  "displayName": "HubSpot",
  "version": "0.1.0",
  "minClientVersions": {
    "cursor": "3.13.0"
  },
  "description": "Secure read and write access to your HubSpot CRM data — contacts, deals, engagements, and more.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://developers.hubspot.com/mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "hubspot",
    "crm",
    "contacts",
    "deals",
    "sales",
    "mcp"
  ],
  "category": "crm",
  "tags": [
    "crm",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "CLIENT_ID": {
        "type": "string",
        "title": "Client ID",
        "description": "The client ID of an MCP connector your team created in HubSpot. Every team member signs in under it.",
        "x-sensitive": false
      },
      "CLIENT_SECRET": {
        "type": "string",
        "title": "Client secret",
        "description": "The client secret of that MCP connector. Stored encrypted.",
        "writeOnly": true,
        "format": "password",
        "x-sensitive": true
      }
    },
    "required": [
      "CLIENT_ID",
      "CLIENT_SECRET"
    ]
  },
  "skills": "./skills/",
  "agents": "./agents/",
  "mcpServers": "./mcp.json"
}
