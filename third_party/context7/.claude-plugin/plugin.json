{
  "name": "context7",
  "displayName": "Context7",
  "version": "0.2.0",
  "description": "Pull up-to-date, version-specific library docs and code examples into the prompt.",
  "author": {
    "name": "BoldCreate Connect"
  },
  "homepage": "https://context7.com/docs/resources/all-clients",
  "repository": "https://github.com/saravananmadhesh/BoldCreate-Plugins",
  "license": "MIT",
  "keywords": [
    "docs",
    "libraries",
    "frameworks",
    "code-examples",
    "mcp"
  ],
  "icon": "./assets/logo.svg",
  "userConfig": {
    "CONTEXT7_API_KEY": {
      "type": "string",
      "title": "Context7 API key",
      "description": "API key from https://context7.com/dashboard.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.CONTEXT7_API_KEY}"
      }
    }
  }
}
