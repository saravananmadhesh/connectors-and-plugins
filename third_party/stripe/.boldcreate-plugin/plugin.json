{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "stripe",
  "displayName": "Stripe",
  "version": "0.7.1",
  "description": "Work with Stripe customers, payments, subscriptions, and search Stripe docs.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.stripe.com/mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "payments",
  "keywords": [
    "stripe",
    "payments",
    "billing",
    "subscriptions",
    "mcp"
  ],
  "hostedBy": "vendor",
  "docs": "https://docs.stripe.com/mcp",
  "upstream": {
    "repository": "https://github.com/stripe/ai",
    "path": "skills",
    "commit": "d8e14797c726086c4376f576f6fb7cbb908e5f15",
    "author": "Stripe",
    "license": "MIT"
  },
  "rollout": {
    "phase": 1,
    "wave": "A"
  },
  "supportedByGateway": true,
  "variables": {},
  "components": {
    "mcp": [
      {
        "name": "stripe",
        "transport": "streamable-http",
        "url": "https://mcp.stripe.com",
        "auth": {
          "type": "oauth",
          "alternatives": [
            "bearer"
          ]
        }
      }
    ],
    "skills": [
      "connect-recommend",
      "connect-required-verification-information",
      "metronome",
      "stripe-apps",
      "stripe-best-practices",
      "stripe-directory",
      "stripe-docs",
      "stripe-pay",
      "stripe-projects",
      "upgrade-stripe"
    ],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "vendor docs"
  }
}
