{
  "name": "zoom",
  "displayName": "Zoom",
  "version": "0.1.0",
  "minClientVersions": {
    "cursor": "3.13.0"
  },
  "description": "Search, ask and act on your Zoom meetings, recordings, notes and docs",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://developers.zoom.us/docs/mcp/zoom/",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "zoom",
    "meetings",
    "recordings",
    "docs",
    "notes",
    "mcp"
  ],
  "category": "productivity",
  "tags": [
    "productivity",
    "meetings",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "CLIENT_ID": {
        "type": "string",
        "title": "Client ID",
        "description": "The client ID of a Zoom General app your team created, with user-level OAuth. Every team member signs in under it.",
        "x-sensitive": false
      },
      "CLIENT_SECRET": {
        "type": "string",
        "title": "Client secret",
        "description": "The client secret of that Zoom app. Stored encrypted.",
        "writeOnly": true,
        "format": "password",
        "x-sensitive": true
      }
    },
    "required": [
      "CLIENT_ID",
      "CLIENT_SECRET"
    ]
  },
  "skills": "./skills/",
  "mcpServers": "./mcp.json"
}
