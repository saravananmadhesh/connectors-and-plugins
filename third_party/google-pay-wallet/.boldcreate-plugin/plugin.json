{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "google-pay-wallet",
  "displayName": "Google Pay and Wallet",
  "version": "0.1.0",
  "description": "Manage Google Pay merchant setup and read Google Wallet issuer data.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://developers.google.com/pay/api/web/guides/use-pay-wallet-mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "payments",
  "keywords": [
    "google pay",
    "google wallet",
    "payments",
    "merchant",
    "mcp"
  ],
  "hostedBy": "vendor",
  "stage": "preview",
  "docs": "https://developers.google.com/pay/api/web/guides/use-pay-wallet-mcp",
  "rollout": {
    "phase": 2,
    "wave": "B"
  },
  "supportedByGateway": true,
  "variables": {
    "CLIENT_ID": {
      "title": "Client ID",
      "description": "A Google OAuth client your team created. Every team member signs in under it.",
      "required": true,
      "secret": false
    },
    "CLIENT_SECRET": {
      "title": "Client secret",
      "description": "The secret for that OAuth client. Stored encrypted.",
      "required": true,
      "secret": true
    }
  },
  "components": {
    "mcp": [
      {
        "name": "google-pay-wallet",
        "transport": "streamable-http",
        "url": "https://paydeveloper.googleapis.com/mcp",
        "auth": {
          "type": "oauth",
          "alternatives": [],
          "oauthClient": {
            "clientId": "${CLIENT_ID}",
            "clientSecret": "${CLIENT_SECRET}"
          },
          "scopes": [
            "https://www.googleapis.com/auth/paydeveloper.merchant",
            "https://www.googleapis.com/auth/paydeveloper.issuer.readonly"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "vendor docs (docs.cloud.google.com/mcp/supported-products)"
  }
}
