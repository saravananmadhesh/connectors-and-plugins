{
  "name": "google-pay-wallet",
  "displayName": "Google Pay and Wallet",
  "version": "0.1.0",
  "minClientVersions": {
    "cursor": "3.19.0"
  },
  "description": "Manage Google Pay merchant setup and read Google Wallet issuer data.",
  "author": {
    "name": "BoldCreate Connect"
  },
  "homepage": "https://developers.google.com/pay/api/web/guides/use-pay-wallet-mcp",
  "repository": "https://github.com/saravananmadhesh/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "google pay",
    "google wallet",
    "payments",
    "merchant",
    "mcp"
  ],
  "category": "payments",
  "tags": [
    "payments",
    "google",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "CLIENT_ID": {
        "type": "string",
        "title": "Client ID",
        "description": "A Google OAuth client your team created. Every team member signs in under it.",
        "x-sensitive": false
      },
      "CLIENT_SECRET": {
        "type": "string",
        "title": "Client secret",
        "description": "The secret for that OAuth client. Stored encrypted.",
        "writeOnly": true,
        "format": "password",
        "x-sensitive": true
      }
    },
    "required": [
      "CLIENT_ID",
      "CLIENT_SECRET"
    ]
  },
  "mcpServers": "./mcp.json"
}
