{
  "name": "google-cloud-error-reporting",
  "displayName": "Google Cloud Error Reporting",
  "version": "0.1.0",
  "minClientVersions": {
    "cursor": "3.19.0"
  },
  "description": "Review grouped application errors from Error Reporting.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.cloud.google.com/error-reporting/reference_mcp/mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "error reporting",
    "errors",
    "exceptions",
    "observability",
    "mcp"
  ],
  "category": "observability",
  "tags": [
    "observability",
    "google cloud",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "CLIENT_ID": {
        "type": "string",
        "title": "Client ID",
        "description": "A Google OAuth client your team created. Every team member signs in under it.",
        "x-sensitive": false
      },
      "CLIENT_SECRET": {
        "type": "string",
        "title": "Client secret",
        "description": "The secret for that OAuth client. Stored encrypted.",
        "writeOnly": true,
        "format": "password",
        "x-sensitive": true
      }
    },
    "required": [
      "CLIENT_ID",
      "CLIENT_SECRET"
    ]
  },
  "mcpServers": "./mcp.json"
}
