{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "google-cloud-memorystore",
  "displayName": "Google Cloud Memorystore",
  "version": "0.1.0",
  "description": "Manage Memorystore for Redis, Redis Cluster, and Valkey instances.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.cloud.google.com/memorystore/docs/valkey/use-memorystore-mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "database",
  "keywords": [
    "memorystore",
    "redis",
    "valkey",
    "cache",
    "mcp"
  ],
  "hostedBy": "vendor",
  "stage": "ga",
  "docs": "https://docs.cloud.google.com/memorystore/docs/valkey/use-memorystore-mcp",
  "rollout": {
    "phase": 2,
    "wave": "B"
  },
  "supportedByGateway": true,
  "variables": {
    "CLIENT_ID": {
      "title": "Client ID",
      "description": "A Google OAuth client your team created. Every team member signs in under it.",
      "required": true,
      "secret": false
    },
    "CLIENT_SECRET": {
      "title": "Client secret",
      "description": "The secret for that OAuth client. Stored encrypted.",
      "required": true,
      "secret": true
    }
  },
  "components": {
    "mcp": [
      {
        "name": "memorystore-redis",
        "transport": "streamable-http",
        "url": "https://redis.googleapis.com/mcp",
        "auth": {
          "type": "oauth",
          "alternatives": [],
          "oauthClient": {
            "clientId": "${CLIENT_ID}",
            "clientSecret": "${CLIENT_SECRET}"
          },
          "scopes": [
            "https://www.googleapis.com/auth/cloud-platform"
          ]
        }
      },
      {
        "name": "memorystore-valkey",
        "transport": "streamable-http",
        "url": "https://memorystore.googleapis.com/mcp",
        "auth": {
          "type": "oauth",
          "alternatives": [],
          "oauthClient": {
            "clientId": "${CLIENT_ID}",
            "clientSecret": "${CLIENT_SECRET}"
          },
          "scopes": [
            "https://www.googleapis.com/auth/cloud-platform"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "vendor docs (docs.cloud.google.com/mcp/supported-products)"
  }
}
